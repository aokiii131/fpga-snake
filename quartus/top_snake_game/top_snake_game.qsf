set_global_assignment -name TOP_LEVEL_ENTITY top_snake_game
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files

set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to clk_50m
set_instance_assignment -name IO_STANDARD "2.5 V" -to rst_sw
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to key[0]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to key[1]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to key[2]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to key[3]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to led_data_out

set_global_assignment -name DEVICE 5CSXFC6D6F31C6
set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top
set_global_assignment -name LAST_QUARTUS_VERSION "23.1std.0 Lite Edition"
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/ws2812b_driver.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/top_snake_game.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/tick_generator.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/game_engine.sv
set_global_assignment -name SYSTEMVERILOG_FILE ../../rtl/button_conditioner.sv
set_global_assignment -name SOURCE_FILE top_snake_game.qsf
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 85
set_global_assignment -name POWER_PRESET_COOLING_SOLUTION "23 MM HEAT SINK WITH 200 LFPM AIRFLOW"
set_global_assignment -name POWER_BOARD_THERMAL_MODEL "NONE (CONSERVATIVE)"
set_global_assignment -name SDC_FILE top_snake_game.sdc


set_location_assignment PIN_AF14 -to clk_50m
set_location_assignment PIN_AB30 -to rst_sw

set_location_assignment PIN_AJ4 -to key[0]
set_location_assignment PIN_AK4 -to key[1]
set_location_assignment PIN_AA14 -to key[2]
set_location_assignment PIN_AA15 -to key[3]

set_location_assignment PIN_W15 -to led_data_out

set_instance_assignment -name CURRENT_STRENGTH_NEW 16MA -to led_data_out
set_instance_assignment -name SLEW_RATE 1 -to led_data_out
set_instance_assignment -name FAST_OUTPUT_REGISTER ON -to led_data_out
set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top
